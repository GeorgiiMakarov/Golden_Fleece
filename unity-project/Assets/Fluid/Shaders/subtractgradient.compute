// SubtractGradient.compute — Fluid Preset Studio baseline v0.2
//
// FIX 2026-09-27: dt removed from the correction.
// JacobiPressure solves ∇²p = div WITHOUT dt (dt is not even a uniform of that
// kernel), so the consistent projection step is u −= ∇p. The original
// u −= dt·∇p damped the correction 50x at dt=0.02: even perfectly converged
// pressure delivered only 2% of the needed correction, making the whole
// projection a near no-op. (Flagged by Claude Sonnet 5 review.)
#pragma kernel SubtractGradient

Texture3D<float4> Velocity; // input velocity
Texture3D<float> Pressure;  // solved pressure
RWTexture3D<float4> Result; // output velocity

int3 dims;
float dx;

[numthreads(8,8,8)]
void SubtractGradient(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= dims.x || id.y >= dims.y || id.z >= dims.z) return;
    int x = id.x, y = id.y, z = id.z;

    float pL = Pressure.Load(int4(max(x-1,0), y, z, 0));
    float pR = Pressure.Load(int4(min(x+1,dims.x-1), y, z, 0));
    float pD = Pressure.Load(int4(x, max(y-1,0), z, 0));
    float pU = Pressure.Load(int4(x, min(y+1,dims.y-1), z, 0));
    float pB = Pressure.Load(int4(x, y, max(z-1,0), 0));
    float pF = Pressure.Load(int4(x, y, min(z+1,dims.z-1), 0));

    float3 gradP = float3((pR - pL) / (2.0 * dx), (pU - pD) / (2.0 * dx), (pF - pB) / (2.0 * dx));

    float4 vel = Velocity.Load(int4(x,y,z,0));
    float3 u = vel.xyz - gradP;

    Result[int3(x,y,z)] = float4(u, vel.w);
}
