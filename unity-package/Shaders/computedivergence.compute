// ComputeDivergence.compute
#pragma kernel ComputeDivergence

Texture3D<float4> Velocity; // input
RWTexture3D<float> Result;  // divergence out

int3 dims;
float dx;

[numthreads(8,8,8)]
void ComputeDivergence(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= dims.x || id.y >= dims.y || id.z >= dims.z) return;
    int x = id.x, y = id.y, z = id.z;

    float uL = Velocity.Load(int4(max(x-1,0), y, z, 0)).x;
    float uR = Velocity.Load(int4(min(x+1,dims.x-1), y, z, 0)).x;
    float vD = Velocity.Load(int4(x, max(y-1,0), z, 0)).y;
    float vU = Velocity.Load(int4(x, min(y+1,dims.y-1), z, 0)).y;
    float wB = Velocity.Load(int4(x, y, max(z-1,0), 0)).z;
    float wF = Velocity.Load(int4(x, y, min(z+1,dims.z-1), 0)).z;

    float div = ((uR - uL) + (vU - vD) + (wF - wB)) / (2.0 * dx);
    Result[int3(x,y,z)] = div;
}
