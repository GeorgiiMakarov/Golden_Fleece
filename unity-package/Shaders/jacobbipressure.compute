// JacobiPressure.compute
#pragma kernel JacobiPressure

Texture3D<float> Divergence; // div
Texture3D<float> Pressure;   // current p
RWTexture3D<float> Result;   // new p

int3 dims;
float dx;

[numthreads(8,8,8)]
void JacobiPressure(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= dims.x || id.y >= dims.y || id.z >= dims.z) return;
    int x = id.x, y = id.y, z = id.z;

    // neighbors
    float pL = Pressure.Load(int4(max(x-1,0), y, z, 0));
    float pR = Pressure.Load(int4(min(x+1,dims.x-1), y, z, 0));
    float pD = Pressure.Load(int4(x, max(y-1,0), z, 0));
    float pU = Pressure.Load(int4(x, min(y+1,dims.y-1), z, 0));
    float pB = Pressure.Load(int4(x, y, max(z-1,0), 0));
    float pF = Pressure.Load(int4(x, y, min(z+1,dims.z-1), 0));

    float div = Divergence.Load(int4(x,y,z,0));

    float alpha = dx * dx;
    float beta = 6.0;

    float pnew = (pL + pR + pD + pU + pB + pF - alpha * div) / beta;
    Result[int3(x,y,z)] = pnew;
}
