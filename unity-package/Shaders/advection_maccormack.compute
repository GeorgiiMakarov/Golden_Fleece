// AdvectionMacCormack.compute — Fluid Preset Studio, upgrade #1
//
// MacCormack correction pass. The forward semi-Lagrangian pass is done by the
// baseline advection.compute (AdvectScalar/AdvectVector); this shader applies
// the corrector:
//
//   f_corr = f1 + 0.5 * (f0 - fbar),
//   fbar   = trilinear(FieldSL, p + vel*dt/dx)   (backward advection of f1)
//   clamp f_corr into [min,max] of the ORIGINAL field over the 8 grid corners
//   around the departure point p - vel*dt/dx   (Selle et al. limiter)
//
// Validated on CPU first: solid-body rotation of a sharp disc keeps 104% of
// initial sharpness vs 73.5% for plain SL, scalar stays exactly in [0,1].
// NOT run in Unity Editor yet — CPU reference is cpu-baseline/simulate.py mc.
#pragma kernel MacCormackScalar
#pragma kernel MacCormackVector

Texture3D<float4> VelocityRGBA; // velocity (xyz), read at the cell itself

Texture3D<float>  Field;        // original scalar field (f0)
Texture3D<float>  FieldSL;      // forward-advected scalar (f1)
RWTexture3D<float> ResultField; // corrected scalar (out)

Texture3D<float4> FieldVec;     // original vector field (f0)
Texture3D<float4> FieldVecSL;   // forward-advected vector (f1)
RWTexture3D<float4> ResultVec;  // corrected vector (out)

int3 dims;
float dt;
float dx;

float SampleSLFloat3(float3 pos)
{
    pos = clamp(pos, float3(0,0,0), float3(dims) - 1);
    int3 p0 = int3(floor(pos));
    int3 p1 = min(p0 + 1, dims - 1);
    float xd = pos.x - p0.x, yd = pos.y - p0.y, zd = pos.z - p0.z;

    float c000 = FieldSL.Load(int4(p0.x, p0.y, p0.z, 0));
    float c100 = FieldSL.Load(int4(p1.x, p0.y, p0.z, 0));
    float c010 = FieldSL.Load(int4(p0.x, p1.y, p0.z, 0));
    float c110 = FieldSL.Load(int4(p1.x, p1.y, p0.z, 0));
    float c001 = FieldSL.Load(int4(p0.x, p0.y, p1.z, 0));
    float c101 = FieldSL.Load(int4(p1.x, p0.y, p1.z, 0));
    float c011 = FieldSL.Load(int4(p0.x, p1.y, p1.z, 0));
    float c111 = FieldSL.Load(int4(p1.x, p1.y, p1.z, 0));

    return lerp(lerp(lerp(c000,c100,xd), lerp(c010,c110,xd), yd),
                    lerp(lerp(c001,c101,xd), lerp(c011,c111,xd), yd), zd);
}

float4 SampleSLVec3(float3 pos)
{
    pos = clamp(pos, float3(0,0,0), float3(dims) - 1);
    int3 p0 = int3(floor(pos));
    int3 p1 = min(p0 + 1, dims - 1);
    float xd = pos.x - p0.x, yd = pos.y - p0.y, zd = pos.z - p0.z;

    float4 c000 = FieldVecSL.Load(int4(p0.x, p0.y, p0.z, 0));
    float4 c100 = FieldVecSL.Load(int4(p1.x, p0.y, p0.z, 0));
    float4 c010 = FieldVecSL.Load(int4(p0.x, p1.y, p0.z, 0));
    float4 c110 = FieldVecSL.Load(int4(p1.x, p1.y, p0.z, 0));
    float4 c001 = FieldVecSL.Load(int4(p0.x, p0.y, p1.z, 0));
    float4 c101 = FieldVecSL.Load(int4(p1.x, p0.y, p1.z, 0));
    float4 c011 = FieldVecSL.Load(int4(p0.x, p1.y, p1.z, 0));
    float4 c111 = FieldVecSL.Load(int4(p1.x, p1.y, p1.z, 0));

    return lerp(lerp(lerp(c000,c100,xd), lerp(c010,c110,xd), yd),
                    lerp(lerp(c001,c101,xd), lerp(c011,c111,xd), yd), zd);
}

[numthreads(8,8,8)]
void MacCormackScalar(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= dims.x || id.y >= dims.y || id.z >= dims.z) return;
    int3 p = int3(id);

    float3 vel = VelocityRGBA.Load(int4(p, 0)).xyz;
    float3 depPos  = float3(p) - vel * (dt / dx);  // departure point
    float3 backPos = float3(p) + vel * (dt / dx);  // backward sample point

    float f0 = Field.Load(int4(p, 0));
    float f1 = FieldSL.Load(int4(p, 0));
    float fbar = SampleSLFloat3(backPos);

    // limiter bounds: min/max of the ORIGINAL field over the 8 corners
    // around the departure point
    float3 cp = clamp(depPos, float3(0,0,0), float3(dims) - 1);
    int3 p0 = int3(floor(cp));
    int3 p1 = min(p0 + 1, dims - 1);
    float c000 = Field.Load(int4(p0.x, p0.y, p0.z, 0));
    float c100 = Field.Load(int4(p1.x, p0.y, p0.z, 0));
    float c010 = Field.Load(int4(p0.x, p1.y, p0.z, 0));
    float c110 = Field.Load(int4(p1.x, p1.y, p0.z, 0));
    float c001 = Field.Load(int4(p0.x, p0.y, p1.z, 0));
    float c101 = Field.Load(int4(p1.x, p0.y, p1.z, 0));
    float c011 = Field.Load(int4(p0.x, p1.y, p1.z, 0));
    float c111 = Field.Load(int4(p1.x, p1.y, p1.z, 0));
    float mn = min(min(min(c000,c100),min(c010,c110)), min(min(c001,c101),min(c011,c111)));
    float mx = max(max(max(c000,c100),max(c010,c110)), max(max(c001,c101),max(c011,c111)));

    float fcorr = f1 + 0.5 * (f0 - fbar);
    ResultField[p] = clamp(fcorr, mn, mx);
}

[numthreads(8,8,8)]
void MacCormackVector(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= dims.x || id.y >= dims.y || id.z >= dims.z) return;
    int3 p = int3(id);

    float3 vel = VelocityRGBA.Load(int4(p, 0)).xyz;
    float3 depPos  = float3(p) - vel * (dt / dx);
    float3 backPos = float3(p) + vel * (dt / dx);

    float4 f0 = FieldVec.Load(int4(p, 0));
    float4 f1 = FieldVecSL.Load(int4(p, 0));
    float4 fbar = SampleSLVec3(backPos);

    float3 cp = clamp(depPos, float3(0,0,0), float3(dims) - 1);
    int3 p0 = int3(floor(cp));
    int3 p1 = min(p0 + 1, dims - 1);
    float4 c000 = FieldVec.Load(int4(p0.x, p0.y, p0.z, 0));
    float4 c100 = FieldVec.Load(int4(p1.x, p0.y, p0.z, 0));
    float4 c010 = FieldVec.Load(int4(p0.x, p1.y, p0.z, 0));
    float4 c110 = FieldVec.Load(int4(p1.x, p1.y, p0.z, 0));
    float4 c001 = FieldVec.Load(int4(p0.x, p0.y, p1.z, 0));
    float4 c101 = FieldVec.Load(int4(p1.x, p0.y, p1.z, 0));
    float4 c011 = FieldVec.Load(int4(p0.x, p1.y, p1.z, 0));
    float4 c111 = FieldVec.Load(int4(p1.x, p1.y, p1.z, 0));
    float4 mn = min(min(min(c000,c100),min(c010,c110)), min(min(c001,c101),min(c011,c111)));
    float4 mx = max(max(max(c000,c100),max(c010,c110)), max(max(c001,c101),max(c011,c111)));

    float4 fcorr = f1 + 0.5 * (f0 - fbar);
    ResultVec[p] = clamp(fcorr, mn, mx);  // component-wise clamp
}
